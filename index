 if(over&&CG.visible){const e=Math.min(1,(now-fillT)/2400),f=Math.max(.02,.5+(fillTo-.5)*(1-Math.pow(1-e,2)));cfill.scale.y=f;cfill.position.y=-.9+.9*f;cmark.position.y=-.9+1.8*f;react(now)}}
function enterRoom(nm){if(over||!DEC.includes(nm)||G.v[nm])return;G.v[nm]=1;add(-5,'Wrong room: '+nm);hubT-=20000;say2(nm=='Cafeteria'?'The cafeteria?! He’s bleeding, not hungry! Minus a minute!':nm=='Radiology'?'Radiology? We already have the scan. Go back! Minus a minute!':'That’s not where we’ll find what he needs. Minus a minute!')}
const PS={m:[-8.3,-12.7,1.9,'📊 Use the matrix',()=>stMatrix()],s:[-8.3,-3.4,1.9,'🗺 Use the strategy grid',()=>stStrategy()],cage:[-11.4,5.4,2.1,'📦 Consignment Cage',()=>stZone('cage')],cold:[-10.45,12.2,1.9,'📦 Cold Storage',()=>stZone('cold')],shelf:[-8.2,8.2,2.1,'📦 Main Shelves',()=>stZone('shelf')],dl:[16,-7.6,2.6,'🩺 Treat the patient',()=>deliver()]};
const RINGS=Object.keys(PS).map(k=>{const m=new T.Mesh(new T.RingGeometry(.75,1.05,36),new T.MeshBasicMaterial({color:k=='dl'?0x6fcf97:0xff7eb6,transparent:true,opacity:.75,side:T.DoubleSide}));m.rotation.x=-Math.PI/2;m.position.set(PS[k][0],FH+.09,PS[k][1]);m.visible=false;HUB.add(m);return [k,m]});
function hotspot(){if(over||busy||pf!==1){actB.style.display='none';return}let h=null;for(const k in PS){const q=PS[k];if(Math.hypot(px-q[0],pz-q[1])<q[2]){h=k;break}}
 if(!h){actB.style.display='none';hk='';return}if(h!==hk){hk=h;actB.textContent=PS[h][3];actB.onclick=PS[h][4]}actB.style.display='block'}
const WHY=['Seals the rupture from the inside. No stent, no repair.','Fast clotting agent to stop the bleeding. Kept temperature-controlled.','Scalpels, clamps and drapes to open and prep the groin.'],STRH=['Consignment + guaranteed minimum','Own stock + safety stock','Par-level auto-reorder'];
const pin=document.createElement('div');pin.id='pin';document.body.appendChild(pin);
const nt=document.createElement('div');nt.id='nt';nt.innerHTML='<b>👩‍⚕️ Ghala:</b> Tap the 📋 <b>Supplies</b> checklist (top right) to start!';document.body.appendChild(nt);
function updPin(f){pin.textContent='⭐ '+G.sc+' · '+(G.act>=0?ITEMS[G.act].ic+' '+ITEMS[G.act].n.split('/')[0].trim():'tap 📋 to choose a supply');if(f){pin.classList.remove('p','m');void pin.offsetWidth;pin.classList.add(f>0?'p':'m')}}
function pulse(on){$('cb').classList.toggle('pul',!!on)}
function closeClip(){$('clip').style.display='none';busy=false}
function renderClip(){document.querySelector('#clip .scr').innerHTML='<div style="display:flex;justify-content:space-between;align-items:center"><b style="font-size:20px">📋 Supply List</b><b>⭐ '+G.sc+'</b></div><div style="font-size:13px;opacity:.8">Tap a supply to work on it</div>'+ITEMS.map((it,i)=>'<div class="ic'+(G.act==i?' on':'')+'" data-i="'+i+'"><div>'+it.ic+' <b>'+it.n+'</b></div><div class="iw">'+WHY[i]+'</div>'+(G.st[i]>=1?'<span class="ch" style="background:'+it.col+'">'+it.cc+'</span>':'')+(G.st[i]>=2?'<span class="ch" style="background:'+it.col+'">'+STRH[it.strat]+'</span>':'')+(G.st[i]==3?'<span class="ch" style="background:#2e9e5b">✓ In Ghala’s tray</span>':'')+'</div>').join('')}
function pick(i){if(G.st[i]==3){say2('That one is already in my tray. Pick another supply.');return}G.act=i;updPin();pulse(0);nt.style.display='none';closeClip();say2('Working on: '+ITEMS[i].n)}
$('cb').onclick=()=>{if(busy||over)return;renderClip();$('clip').style.display='flex';busy=true};
$('clip').onclick=e=>{const d=e.target.closest('.ic');if(d)pick(+d.dataset.i);else closeClip()};
function gameInit(){G={st:[0,0,0],sc:0,log:[],v:{},pt:0,act:-1};busy=over=false;hk='';camOv=camS=null;CG.visible=false;pin.style.display='block';updPin();nt.style.display='block';pulse(1);setTimeout(()=>say2('The clock is running! I won’t tell you where to go. Use what you know.'),1200)}
requestAnimationFrame(loop);
</script></body></html>
